# =============== #
# Unity.gitignore #
# =============== #

# OS generated files
.DS_Store
Thumbs.db

# User-specific files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Unity specific
Library/
Temp/
Obj/
Build/
Builds/
Logs/
MemoryCaptures/
UserSettings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!*.meta

# Crash reports
sysinfo.txt

# Cache
*.stackdump
*.apk
*.aab
*.unitypackage
*.app

# Visual Studio Code
.vscode/

# Rider
.idea/

# Gradle cache
.gradle/

# Autogenerated Android/Gradle files
.gradle/
**/build/
*.keystore

# iOS Xcode
xcuserdata/
DerivedData/

# Packed Addressables
*/ServerData/

# Unity Collaborate
.collab/

# Ignore generated Visual Studio / JetBrains Rider project files
ExportedObj/
.consulo/
